<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Declares audio support for when the vehicle shifts into drive -->
    <uses-feature
        android:name="com.android.car.background_audio_while_driving"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:appCategory="video"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarVideoStreamer">

        <activity
            android:name=".VideoPlayerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Essential category for Android Auto parked app launcher -->
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
